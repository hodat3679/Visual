-- HoDat Hub

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local Settings = {
    PlayerESP = true,
    BrainrotESP = true,
    RareESP = true,
    TsunamiAlert = true
}

-- UI
local gui = Instance.new("ScreenGui")
gui.Name = "BrainrotVisualPro"
gui.Parent = game.CoreGui

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0,230,0,180)
frame.Position = UDim2.new(0,20,0,200)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,30)
title.Text = "Brainrot Visual PRO"
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1,1,1)

local function Button(text,y,callback)
    local b = Instance.new("TextButton")
    b.Parent = frame
    b.Size = UDim2.new(1,0,0,30)
    b.Position = UDim2.new(0,0,0,y)
    b.Text = text
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    b.MouseButton1Click:Connect(callback)
end

Button("Toggle Player ESP",35,function()
    Settings.PlayerESP = not Settings.PlayerESP
end)

Button("Toggle Brainrot ESP",70,function()
    Settings.BrainrotESP = not Settings.BrainrotESP
end)

Button("Toggle Rare ESP",105,function()
    Settings.RareESP = not Settings.RareESP
end)

Button("Toggle Tsunami Alert",140,function()
    Settings.TsunamiAlert = not Settings.TsunamiAlert
end)

-- Highlight function
local function AddHighlight(obj,color)
    if obj:FindFirstChild("VisualTag") then return end
    local h = Instance.new("Highlight")
    h.Name = "VisualTag"
    h.FillColor = color
    h.FillTransparency = 0.4
    h.OutlineTransparency = 0
    h.Parent = obj
end

-- Player ESP
local function SetupPlayer(player)
    if player == LocalPlayer then return end

    player.CharacterAdded:Connect(function(char)
        task.wait(1)
        if Settings.PlayerESP then
            AddHighlight(char,Color3.fromRGB(255,60,60))
        end
    end)
end

for _,p in pairs(Players:GetPlayers()) do
    SetupPlayer(p)
end

Players.PlayerAdded:Connect(SetupPlayer)

-- Brainrot ESP
task.spawn(function()
    while task.wait(2) do
        if not Settings.BrainrotESP then continue end

        for _,v in pairs(workspace:GetDescendants()) do
            if string.find(v.Name:lower(),"brainrot") then

                if Settings.RareESP and (string.find(v.Name:lower(),"mythic") or string.find(v.Name:lower(),"legend")) then
                    AddHighlight(v,Color3.fromRGB(255,215,0))
                else
                    AddHighlight(v,Color3.fromRGB(0,255,120))
                end

            end
        end
    end
end)

-- Tsunami alert
task.spawn(function()
    while task.wait(1) do
        if not Settings.TsunamiAlert then continue end

