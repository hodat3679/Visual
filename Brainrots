-- Brainrot Visual Hub

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Settings = {
    PlayerESP = true,
    BrainrotESP = true
}

-- UI
local gui = Instance.new("ScreenGui")
gui.Name = "BrainrotHub"
gui.Parent = game.CoreGui

local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0,420,0,260)
main.Position = UDim2.new(0.35,0,0.3,0)
main.BackgroundColor3 = Color3.fromRGB(22,22,22)

local sidebar = Instance.new("Frame")
sidebar.Parent = main
sidebar.Size = UDim2.new(0,120,1,0)
sidebar.BackgroundColor3 = Color3.fromRGB(30,30,30)

local content = Instance.new("Frame")
content.Parent = main
content.Position = UDim2.new(0,120,0,0)
content.Size = UDim2.new(1,-120,1,0)
content.BackgroundTransparency = 1

-- tab
local visualTab = Instance.new("TextButton")
visualTab.Parent = sidebar
visualTab.Size = UDim2.new(1,0,0,40)
visualTab.Text = "Visual"
visualTab.BackgroundColor3 = Color3.fromRGB(40,40,40)
visualTab.TextColor3 = Color3.new(1,1,1)

-- toggle
local espToggle = Instance.new("TextButton")
espToggle.Parent = content
espToggle.Size = UDim2.new(0,160,0,40)
espToggle.Position = UDim2.new(0,20,0,20)
espToggle.Text = "Player ESP : ON"
espToggle.BackgroundColor3 = Color3.fromRGB(50,50,50)

espToggle.MouseButton1Click:Connect(function()
    Settings.PlayerESP = not Settings.PlayerESP

    if Settings.PlayerESP then
        espToggle.Text = "Player ESP : ON"
    else
        espToggle.Text = "Player ESP : OFF"
    end
end)

-- highlight function
local function Highlight(obj,color)

    if obj:FindFirstChild("BrainrotTag") then return end

    local h = Instance.new("Highlight")
    h.Name = "BrainrotTag"
    h.FillColor = color
    h.FillTransparency = 0.4
    h.Parent = obj

end

-- player esp
local function SetupPlayer(player)

    if player == LocalPlayer then return end

    player.CharacterAdded:Connect(function(char)

        task.wait(1)

        if Settings.PlayerESP then
            Highlight(char,Color3.fromRGB(255,0,0))
        end

    end)

end

for _,p in pairs(Players:GetPlayers()) do
    SetupPlayer(p)
end

Players.PlayerAdded:Connect(SetupPlayer)

-- brainrot esp
task.spawn(function()

    while task.wait(2) do

        if not Settings.BrainrotESP then continue end

        for _,v in pairs(workspace:GetDescendants()) do

            if string.find(v.Name:lower(),"brainrot") then
                Highlight(v,Color3.fromRGB(0,255,120))
            end

        end

    end

end)
